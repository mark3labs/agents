# Copy to .env and fill in. BONNIE loads .env from the agent's directory at
# startup. Never commit .env.

# --- Required -----------------------------------------------------------------

# Fine-grained token for the one repository: Pull requests (write), Issues
# (write), Actions (write), Metadata (read). Ideally from a dedicated bot
# account. See "Token" in the README.
GITHUB_TOKEN=

# Key for the default chat and decision models (both via OpenRouter). Not
# needed if triage.yaml names models from another provider; set that
# provider's key instead.
OPENROUTER_API_KEY=

# --- Optional overrides ------------------------------------------------------
# Each one overrides the matching field in triage.yaml.

# The repository to triage, as owner/name.
#GITHUB_REPO=owner/name

# false to write to GitHub; true logs intended writes instead.
#TRIAGE_DRY_RUN=true

# Path to the config file (default: triage.yaml).
#TRIAGE_CONFIG=triage.yaml

# Path to the state database (default: .bonnie/triage.db).
#TRIAGE_DB=.bonnie/triage.db

# --- Rarely needed -----------------------------------------------------------

# The bot's login, for GitHub App installation tokens (they can't read /user).
#GITHUB_BOT_LOGIN=my-app[bot]

# API root for GitHub Enterprise Server.
#GITHUB_API_URL=https://github.example.com/api/v3

# true turns the HTTP API on, for bonnie dev, chat and manual poll triggers.
#TRIAGE_HTTP_API=true
